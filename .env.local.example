# LOCAL DEVELOPMENT ONLY — gitignored when copied to `.env.local`
#
# Do not fill this by hand after a local deploy.
# Run:
#   npm run contracts:deploy:local
#
# That command writes:
#   deployments/local-31337.json     ← source of truth for local contract addresses
#   .env.local                       ← generated RPC, DB, and a copy of those addresses
#
# Header, launch, trading, /status, indexer, and scripts resolve contracts
# through packages/config (JSON overlay on chain 31337, then env).
#
# Values below show the SHAPE the script writes. They are not live secrets.

# NODE_ENV=development
# CHAIN_ID=31337
# RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgres://fused:fused@127.0.0.1:5432/fused_ai
# LAUNCH_FACTORY_ADDRESS=<from deployments/local-31337.json>
# LAUNCH_LOCKER_ADDRESS=<from deployments/local-31337.json>
# UNISWAP_POOL_MANAGER_ADDRESS=<from deployments/local-31337.json>
# UNISWAP_POSITION_MANAGER_ADDRESS=<from deployments/local-31337.json>
# UNISWAP_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# LAUNCH_DEPLOY_BLOCK=<Anvil block>
# INDEXER_START_BLOCK=<same>
# INDEXER_SYNC_LOOP=1
# MEDIA_STORE=local
# MEDIA_LOCAL_PATH=.local-data/media
# PUBLIC_LAUNCH_ENABLED=true
# PUBLIC_CHAIN_CONFIGURED=false
# FUSED_VIRTUAL_QUOTE_WEI=50000000000000000
# FUSED_VIRTUAL_TOKEN=1000000000000000000000000000
# FUSED_GRADUATION_TARGET_WEI=100000000000000000
# FUSED_FEE_BPS=0
# FUSED_LP_FEE=10000
#
# Optional (keep in .env.local, never commit):
# SOCIAL_PROVIDER=
# X_BEARER_TOKEN=
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
#
# DEPLOYER_PRIVATE_KEY in this file is the well-known Anvil #0 test key.
# Public-chain deploys read a real key from root `.env` only and ignore this one.
