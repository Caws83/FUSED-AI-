{
  "name": "fused-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Fused AI — social-first EVM token launchpad. Launch a token with just 1 click from a tweet.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fused-ai/web",
    "build": "npm run build --workspace=@fused-ai/web",
    "start": "npm run start --workspace=@fused-ai/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/local-deploy.test.mjs scripts/testnet-env.test.mjs",
    "test:packages": "npm run test --workspace=@fused-ai/types --workspace=@fused-ai/shared --workspace=@fused-ai/validation --workspace=@fused-ai/config --workspace=@fused-ai/social --workspace=@fused-ai/ai --workspace=@fused-ai/blockchain --workspace=@fused-ai/database",
    "build:web": "npm run build --workspace=@fused-ai/web",
    "status": "node --experimental-strip-types --no-warnings apps/api/src/cli.ts",
    "chain": "node scripts/chain.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.mjs",
    "contracts:deploy:local": "node scripts/deploy-local.mjs",
    "contracts:deploy:testnet": "node --experimental-strip-types --no-warnings scripts/deploy-testnet.mjs",
    "contracts:launch:local": "node scripts/launch-local.mjs",
    "env:testnet": "node --experimental-strip-types --no-warnings scripts/print-testnet-env.mjs",
    "contracts:e2e:local": "node --experimental-strip-types --no-warnings scripts/e2e-curve.mjs",
    "indexer": "npm run start --workspace=@fused-ai/indexer",
    "local:reset": "node scripts/local-reset.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build:prodcheck": "node scripts/production-build-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@reown/appkit@1.8.24": true,
    "@reown/appkit@1.7.8": true,
    "bufferutil@4.1.0": true,
    "keccak@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@5.0.10": true
  }
}
