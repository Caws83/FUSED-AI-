# Fused AI environment template
# Copy nothing from here into git. Copy to `.env` only if you need extra secrets.
# Local Anvil addresses are written by `npm run contracts:deploy:local` into
# gitignored `.env.local` and `deployments/local-31337.json`.
#
# Never commit real secrets. Never put secrets on NEXT_PUBLIC_*.
# Do not paste OpenLaunch live factory/locker addresses as Fused AI defaults.

# ==========================================
# FUSED AI — REQUIRED LOCAL
# ==========================================
# Filled automatically into .env.local by npm run contracts:deploy:local

NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
CHAIN_ID=
RPC_URL=
DATABASE_URL=

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
FUSED_SITE_URL=http://localhost:3000
LOG_LEVEL=info
API_PORT=3001

# ==========================================
# LOCAL / FUSED CONTRACTS
# ==========================================
# LAUNCH_FACTORY_ADDRESS is the FusedFactory (curve) address.
# Alias FUSED_FACTORY_ADDRESS is also accepted.
# Leave blank in this file. Local deploy writes .env.local.

LAUNCH_FACTORY_ADDRESS=
LAUNCH_LOCKER_ADDRESS=
FUSED_FACTORY_ADDRESS=
FUSED_LOCKER_ADDRESS=
LAUNCH_DEPLOY_BLOCK=

# ==========================================
# UNISWAP (canonical for the configured chain)
# ==========================================
# Leave blank rather than guessing. Local deploy fills Anvil addresses.

UNISWAP_POOL_MANAGER_ADDRESS=
UNISWAP_POSITION_MANAGER_ADDRESS=
UNISWAP_UNIVERSAL_ROUTER_ADDRESS=
UNISWAP_STATE_VIEW=
UNISWAP_QUOTER=
UNISWAP_V3_FACTORY=
UNISWAP_V2_FACTORY=

# Canonical Permit2 (CREATE2). Same on most EVM chains. Confirm per chain.
UNISWAP_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

RPC_URL_FALLBACK=

# ==========================================
# OPTIONAL WALLETCONNECT
# ==========================================

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=

# Foundry scripts only. Never a user launch key. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# ==========================================
# OPTIONAL X
# ==========================================

SOCIAL_PROVIDER=
X_BEARER_TOKEN=
X_APP_ONLY_TOKEN=
X_API_KEY=
X_API_SECRET=
TRACKED_ACCOUNTS_PATH=config/tracked-accounts.json
TRENDING_VELOCITY_WEIGHT=0.45
TRENDING_RECENCY_WEIGHT=0.25
TRENDING_TOTALS_WEIGHT=0.30
TRENDING_PRIORITY_WEIGHT=0.10

# ==========================================
# OPTIONAL AI
# ==========================================

AI_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000

AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE_URL=
AI_IMAGE_MODEL=

# ==========================================
# MEDIA
# ==========================================
# Local filesystem is for Anvil only. Production must use s3 or r2.
# Do not set MEDIA_STORE=local on Vercel.

MEDIA_STORE=
MEDIA_LOCAL_PATH=
IMAGE_STORE=
IMAGE_PUBLIC_BASE=
MEDIA_PUBLIC_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
BUCKET_NAME=

# ==========================================
# INDEXER (persistent worker, not Vercel)
# ==========================================

INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL=15000
INDEXER_INTERVAL_MS=15000
INDEXER_OVERLAP_BLOCKS=50
INDEXER_LAG_ALERT_BLOCKS=200
INDEXER_SYNC_LOOP=0

# ==========================================
# PUBLIC FEATURE FLAGS
# ==========================================
# Production website can ship before public contracts exist.
# Defaults: production launch OFF. Local Anvil launch ON after deploy.

PUBLIC_CHAIN_CONFIGURED=
PUBLIC_LAUNCH_ENABLED=
STATUS_PAGE_PUBLIC=

# Display-only USD estimate for the graduation target. Not an oracle.
# Contract target is native quote units (wei), set at deploy time.
NEXT_PUBLIC_GRADUATION_TARGET_USD=

# ==========================================
# CURVE (constructor args — not compiled prod constants)
# ==========================================
# Local defaults (Anvil only, via deploy script): 0.05 ETH virtual quote,
# 1B virtual token, 0.1 ETH graduation, 0 fee bps, lpFee 10000.
# Public networks MUST set every value explicitly. No local fallback.

FUSED_PUBLIC_NETWORK=
FUSED_VIRTUAL_QUOTE_WEI=
FUSED_VIRTUAL_TOKEN=
FUSED_GRADUATION_TARGET_WEI=
FUSED_FEE_BPS=
FUSED_LP_FEE=

# ==========================================
# TOKENIZED ASSETS
# ==========================================

TOKENIZED_ASSET_REGISTRY_PATH=

# ==========================================
# ADMIN / OPS
# ==========================================

ADMIN_WALLETS=
PRESENCE_SALT=

# =============================================================================
# UPSTREAM REFERENCES (documentation only — do not enable as Fused AI prod)
# OpenLaunch (commit d9e215e) live addresses, identical on Base and Robinhood:
#   LaunchFactory 0x815542E8b392389A1389E22E588E4B62A67Ade72
#   LaunchLocker  0xcd1680D26922fcd9CabFbb8a56bA40C333fD842a
# =============================================================================
