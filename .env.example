# Fused AI environment template
# Copy to `.env` at the repository root (gitignored). Never commit real secrets.
#
# Next.js also loads this file via apps/web/next.config.ts.
# Optional override: apps/web/.env.local (gitignored).
#
# Policy:
# - Missing values are typed NOT_CONFIGURED. Do not invent production addresses.
# - Server secrets MUST NOT be duplicated as NEXT_PUBLIC_*.
# - NEXT_PUBLIC_RPC_URL must be a public RPC. Do not put a keyed/private RPC there.
# - Do not paste OpenLaunch live factory/locker addresses as Fused AI defaults.

# ==================================================
# APPLICATION
# ==================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
FUSED_SITE_URL=http://localhost:3000
LOG_LEVEL=info
API_PORT=3001

# ==================================================
# CHAIN
# ==================================================

# Server-side (indexer, scripts). May be a private RPC.
CHAIN_ID=
RPC_URL=
RPC_URL_FALLBACK=

# Browser-side wallet / wagmi. Public RPC only. Leave blank to hide Connect Wallet.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=

# ==================================================
# WALLET
# ==================================================

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=

# Deployer key is for Foundry scripts only. Server never launches for users.
DEPLOYER_PRIVATE_KEY=

# ==================================================
# FUSED AI CONTRACTS
# ==================================================

# Empty until Fused AI deploys. Do not use OpenLaunch production addresses.
LAUNCH_FACTORY_ADDRESS=
LAUNCH_LOCKER_ADDRESS=
LAUNCH_DEPLOY_BLOCK=

# ==================================================
# UNISWAP
# ==================================================
# Canonical protocol deployments for the configured chain — not Fused AI contracts.
# Leave blank rather than guessing. Aliases without `_ADDRESS` are also accepted.

UNISWAP_POOL_MANAGER_ADDRESS=
UNISWAP_POSITION_MANAGER_ADDRESS=
UNISWAP_UNIVERSAL_ROUTER_ADDRESS=
UNISWAP_STATE_VIEW=
UNISWAP_QUOTER=
UNISWAP_V3_FACTORY=
UNISWAP_V2_FACTORY=

# Canonical Permit2 (CREATE2, same address on most EVM chains). Confirm before a given chain.
UNISWAP_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# ==================================================
# DATABASE
# ==================================================

DATABASE_URL=

# ==================================================
# INDEXER
# ==================================================

INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL=15000
INDEXER_INTERVAL_MS=15000
INDEXER_OVERLAP_BLOCKS=50
INDEXER_LAG_ALERT_BLOCKS=200
INDEXER_SYNC_LOOP=0

# ==================================================
# SOCIAL / X
# ==================================================

SOCIAL_PROVIDER=
X_BEARER_TOKEN=
X_APP_ONLY_TOKEN=
X_API_KEY=
X_API_SECRET=
TRACKED_ACCOUNTS_PATH=
TRENDING_VELOCITY_WEIGHT=0.45
TRENDING_RECENCY_WEIGHT=0.25
TRENDING_TOTALS_WEIGHT=0.30

# ==================================================
# AI
# ==================================================

AI_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000

# ==================================================
# TOKENIZED ASSETS
# ==================================================

TOKENIZED_ASSET_REGISTRY_PATH=

# ==================================================
# STORAGE / METADATA
# ==================================================

IMAGE_STORE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
BUCKET_NAME=
IMAGE_PUBLIC_BASE=

# ==================================================
# ADMIN / OPS
# ==================================================

ADMIN_WALLETS=
PRESENCE_SALT=

# =============================================================================
# UPSTREAM REFERENCES (documentation only — do not enable as Fused AI prod)
