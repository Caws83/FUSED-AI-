# FUSED AI env template — copy keys you need into gitignored `.env` or `.env.local`.
# Never commit real secrets. Never put secrets on NEXT_PUBLIC_* keys.
# Contract addresses come from deployments/*.json, not from hand-pasted lists.
# Local: npm run contracts:deploy:local  →  deployments/local-31337.json + .env.local
# Testnet: npm run env:testnet  (after a real deploy, npm run contracts:deploy:testnet)
# Do not create apps/web/.env or contracts/.env. Root files only.

# ------------------------------------------
# 1. BASIC APP
# ------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
FUSED_SITE_URL=http://localhost:3000
LOG_LEVEL=info
API_PORT=3001

# ------------------------------------------
# 2. BLOCKCHAIN (browser + server RPC)
# ------------------------------------------
# Local Anvil is 31337. Robinhood testnet is 46630. Robinhood mainnet is 4663 — do not deploy there yet.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
CHAIN_ID=
RPC_URL=
RPC_URL_FALLBACK=

# Fused factory/locker — leave blank. Overlay from deployments JSON.
LAUNCH_FACTORY_ADDRESS=
LAUNCH_LOCKER_ADDRESS=
FUSED_FACTORY_ADDRESS=
FUSED_LOCKER_ADDRESS=
LAUNCH_DEPLOY_BLOCK=

# Uniswap v4 — leave blank. Testnet addresses come from deployments/robinhood-testnet-46630.example.json.
UNISWAP_POOL_MANAGER_ADDRESS=
UNISWAP_POSITION_MANAGER_ADDRESS=
UNISWAP_UNIVERSAL_ROUTER_ADDRESS=
UNISWAP_STATE_VIEW=
UNISWAP_QUOTER=
UNISWAP_V3_FACTORY=
UNISWAP_V2_FACTORY=
UNISWAP_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Production launch stays off until you set this true after a real public deploy.
PUBLIC_CHAIN_CONFIGURED=
PUBLIC_LAUNCH_ENABLED=
STATUS_PAGE_PUBLIC=

# Display-only USD estimate. Not an oracle. Not written into the contract.
NEXT_PUBLIC_GRADUATION_TARGET_USD=

# Public-network constructor args. Must be explicit. No local 0.1 ETH fallback.
FUSED_PUBLIC_NETWORK=
FUSED_VIRTUAL_QUOTE_WEI=
FUSED_VIRTUAL_TOKEN=
FUSED_GRADUATION_TARGET_WEI=
FUSED_FEE_BPS=
FUSED_LP_FEE=

# ------------------------------------------
# 3. DEPLOYMENT ONLY (Foundry). Never a user wallet. Never NEXT_PUBLIC.
# Put a real key in root `.env` only. `.env.local` may contain the Anvil test key — deploy scripts ignore that.
# ------------------------------------------
DEPLOYER_PRIVATE_KEY=

# ------------------------------------------
# 4. DATABASE / INDEXER (explore, charts, history — not required for the site or direct on-chain launch)
# ------------------------------------------
DATABASE_URL=
INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL=15000
INDEXER_INTERVAL_MS=15000
INDEXER_OVERLAP_BLOCKS=50
INDEXER_LAG_ALERT_BLOCKS=200
INDEXER_MAX_RANGE_BLOCKS=2000
INDEXER_SYNC_LOOP=0

# ------------------------------------------
# 5. OPTIONAL X (manual launch works without this)
# ------------------------------------------
SOCIAL_PROVIDER=
X_BEARER_TOKEN=
X_APP_ONLY_TOKEN=
X_API_KEY=
X_API_SECRET=
TRACKED_ACCOUNTS_PATH=config/tracked-accounts.json
TRENDING_VELOCITY_WEIGHT=0.45
TRENDING_RECENCY_WEIGHT=0.25
TRENDING_TOTALS_WEIGHT=0.30
TRENDING_PRIORITY_WEIGHT=0.10

# ------------------------------------------
# 6. OPTIONAL AI (manual launch works without this)
# ------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE_URL=
AI_IMAGE_MODEL=

# ------------------------------------------
# 7. OPTIONAL MEDIA / WALLETCONNECT
# Local filesystem media is Anvil-only. Production needs s3 or r2.
# ------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=
MEDIA_STORE=
MEDIA_LOCAL_PATH=
IMAGE_STORE=
IMAGE_PUBLIC_BASE=
MEDIA_PUBLIC_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
BUCKET_NAME=
TOKENIZED_ASSET_REGISTRY_PATH=
ADMIN_WALLETS=
PRESENCE_SALT=
