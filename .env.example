# =============================================================================
# Fused AI — environment template
# Copy to `.env` (never commit real values).
#
# Policy: missing credentials MUST surface as typed unavailable states
# (NOT_CONFIGURED / PROVIDER_UNAVAILABLE / RPC_UNAVAILABLE / DATABASE_UNAVAILABLE).
# Do not invent production contract addresses. OpenLaunch / Quiver addresses
# below are UPSTREAM REFERENCES only and must not be treated as Fused AI deploys.
# =============================================================================

# --- Site / runtime ----------------------------------------------------------
NODE_ENV=development
FUSED_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (Postgres) -----------------------------------------------------
# Required for indexer + API persistence. If unset, services return DATABASE_UNAVAILABLE.
DATABASE_URL=

# --- Chains / RPC ------------------------------------------------------------
# Fused AI has not selected a production chain yet. Leave blank until a real
# deployment exists. Do not paste OpenLaunch factory addresses here.
CHAIN_ID=
RPC_URL=
RPC_URL_FALLBACK=

# Optional additional chains (unused until adapters + contracts exist)
# BASE_CHAIN_ID=8453
# BASE_RPC_URL=
# ROBINHOOD_CHAIN_ID=4663
# ROBINHOOD_RPC_URL=

# --- Uniswap (canonical protocol deployments, not Fused AI contracts) --------
# Fill only for the chain you actually target. Leave blank rather than guessing.
UNISWAP_POOL_MANAGER=
UNISWAP_POSITION_MANAGER=
UNISWAP_STATE_VIEW=
UNISWAP_QUOTER=
UNISWAP_UNIVERSAL_ROUTER=
UNISWAP_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
UNISWAP_V3_FACTORY=
UNISWAP_V2_FACTORY=

# --- Fused AI launch contracts -----------------------------------------------
# Empty until Fused AI deploys its own factory/locker. UI must not advertise
# launch as operational while these are unset.
LAUNCH_FACTORY_ADDRESS=
LAUNCH_LOCKER_ADDRESS=
LAUNCH_DEPLOY_BLOCK=

# --- Indexer -----------------------------------------------------------------
INDEXER_SYNC_LOOP=0
INDEXER_CONFIRMATIONS=2
INDEXER_INTERVAL_MS=15000
INDEXER_OVERLAP_BLOCKS=50
INDEXER_LAG_ALERT_BLOCKS=200

# --- Social ingestion --------------------------------------------------------
# No silent mock feed. Missing credentials → NOT_CONFIGURED.
SOCIAL_PROVIDER=
# x | twitter | mastodon | ...
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_APP_ONLY_TOKEN=
TRACKED_ACCOUNTS_PATH=./packages/social/tracked-accounts.example.json
TRENDING_VELOCITY_WEIGHT=0.45
TRENDING_RECENCY_WEIGHT=0.25
TRENDING_TOTALS_WEIGHT=0.30

# --- AI launch generation ----------------------------------------------------
# Provider id is selected by env, never hardcoded in application logic.
AI_PROVIDER=
# openai | anthropic | grok | none
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000

# --- Storage / metadata ------------------------------------------------------
IMAGE_STORE=local
# local | s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
BUCKET_NAME=
IMAGE_PUBLIC_BASE=

# --- Tokenized asset registry ------------------------------------------------
# Path to an allowlist JSON keyed by chainId + contractAddress.
# Empty / missing file → registry NOT_CONFIGURED. Never resolve assets by ticker.
TOKENIZED_ASSET_REGISTRY_PATH=./packages/blockchain/tokenized-assets.example.json

# --- Wallet / signing (server must NEVER hold user keys) ---------------------
# Deployer key is for contract deployment scripts only, not for user launches.
DEPLOYER_PRIVATE_KEY=

# Browser wallet (wagmi + injected). Unset CHAIN_ID / RPC_URL → Connect Wallet
# is disabled and labeled "Wallet not configured". Do not fake a session.
# Do not put a secret RPC key in a NEXT_PUBLIC_* variable.
WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Admin / ops -------------------------------------------------------------
ADMIN_WALLETS=
PRESENCE_SALT=

# =============================================================================
# UPSTREAM REFERENCES (documentation only — do not enable as Fused AI prod)
# OpenLaunch (commit d9e215e) live addresses, identical on Base and Robinhood:
#   LaunchFactory 0x815542E8b392389A1389E22E588E4B62A67Ade72
#   LaunchLocker  0xcd1680D26922fcd9CabFbb8a56bA40C333fD842a
# Quiver (commit 973c31c) Robinhood Chain 4663 factory (admin-gated):
#   0x1FdCc42e982A9555D1134FdA56Ac739F534642c4
# =============================================================================
