# Isolated Arc Mainnet indexer. Do NOT use these values on the Robinhood Railway services.
# Postgres may be shared only because every table is keyed by chain_id.
# fused_sync_cursor PRIMARY KEY is chain_id — Arc 5042 cannot overwrite 4663 or 46630.
# fused_factory_sync_cursor PRIMARY KEY is (chain_id, factory).

